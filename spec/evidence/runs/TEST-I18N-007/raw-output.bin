[18d Wert eingegeben werden. Die folgenden Tasten(-kombinationen) sind im[19d Hauptfenster verfügbar. Alternative Tasten stehen in Klammern:[21d^G     (F1)[18GDiese Hilfe anzeigen[2d[23;2H[0;7mG[m Hilfe     [0;7m^O[m Speichern [0;7m^F[m Wo ist    [0;7m^K[m Ausschneid[0;7m^T[m Ausführen [0;7m^C[m Position[K[24;4HBeenden   [0;7m^R[m Öffnen    [0;7m^\[m Ersetzen  [0;7m^U[m Einfügen  [0;7m^J[m Ausrichten[0;7m^/[m Zu Zeile[K[1;3H[0;7mGNU nano 9.3[1;31H         f.txt      [79G[m[2deins[3dzwei[K[4d[K[5d[K[6d[K[7d[K[8d[K[9d[K[11d[K[12d[K[13d[K[14d[K[15d[K[16d[K[17d[K[18d[K[19d[K[21d[K[2d[34h[?25h[?25l[23d[J[24d[34h[?25h[24;1H[?1049l[?1l>[?2004l