ain editor window.[18d Alternative keys are shown in parentheses:[20d^G     (F1)[18GDisplay this help text[21d^X     (F2)[18GClose the current buffer / Exit from nano[2d[23;2H[0;7mG[m Help      [0;7m^O[m Write Out [0;7m^F[m Where Is  [0;7m^K[m Cut       [0;7m^T[m Execute   [0;7m^C[m Location   [24;4HExit [15G[0;7mR[m Read File [0;7m^\[m Replace   [0;7m^U[m Paste     [0;7m^J[m Justify   [0;7m^/[m Go To[79G[1;3H[0;7mGNU nano 9.3[1;32H      New Buffer   [79G[m[3d[K[4d[K[5d[K[6d[K[7d[K[8d[K[9d[K[11d[K[12d[K[13d[K[14d[K[15d[K[16d[K[17d[K[18d[K[20d[K[21d[K[2d[34h[?25h[?25l[23d[J[24d[34h[?25h[24;1H[?1049l[?1l>[?2004l